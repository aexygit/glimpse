<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="glimpse"
        Arguments=""
        InstallLocation="C:\Program Files\aexygit\Glimpse">
    </Installer>
    <PackageInformation
        PackageName="Glimpse"
        PackageDisplayName="Glimpse"
        PublisherName="CN=aexygit"
        PublisherDisplayName="aexygit"
        Version="0.0.1.0"
        PackageDescription="Aion 2 gear inspector">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.aexygit.glimpse"
                Description="Aion 2 gear inspector"
                DisplayName="Glimpse"
                ExecutableName="glimpse"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Glimpse</DisplayName>
            <PublisherDisplayName>aexygit</PublisherDisplayName>
            <Description>Aion 2 gear inspector</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="glimpse.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
